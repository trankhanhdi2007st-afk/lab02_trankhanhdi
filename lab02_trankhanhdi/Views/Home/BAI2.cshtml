@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <title>Bài 2 - Bố cục trang web</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            color: #777;
        }

      
        #container {
            width: 760px;
            margin: 20px auto;
        }




        #menu {
            height: 38px;
            background-color: white;
            position: relative;
        }

            #menu a {
                display: inline-block;
                padding: 14px 12px 10px 12px;
                color: #666;
                text-decoration: none;
                font-size: 10px;
            }

                #menu a:hover {
                    color: #e87510;
                }

       

            #menu .active {
                background-color: #ed790c;
                color: white;
                height: 38px;
                padding-left: 18px;
                padding-right: 18px;
            }


        #banner {
            height: 145px;
            background-image: url("https://kenh14cdn.com/203336854389633024/2021/10/14/zeros-sbtc-2-16342218082682100217510.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: relative;
        }

            
            #banner::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                bottom: 0;
                background-color: rgba(255, 255, 255, 0.15);
            }

     

        #logo {
            position: absolute;
            right: 20px;
            top: 60px;
            z-index: 2;
            background-color: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px 15px;
            font-size: 16px;
            font-weight: bold;
        }



        #main {
            display: flex;
            gap: 40px;
            padding: 20px 25px 15px 25px;
        }


      

        #about {
            width: 55%;
        }

      

        #projects {
            width: 45%;
        }


        

        .title {
            color: #e87510;
            font-size: 14px;
            margin-bottom: 14px;
            font-weight: normal;
        }


       

        p {
            font-size: 10px;
            line-height: 1.6;
            margin-bottom: 15px;
            color: #777;
        }



        a {
            color: #e87510;
            text-decoration: none;
        }


     

        #contact {
            margin-top: 18px;
        }

            #contact p {
                margin-bottom: 3px;
            }


   

        .project {
            margin-bottom: 18px;
        }

            .project h4 {
                margin-bottom: 3px;
                color: #777;
                font-size: 11px;
            }

            .project p {
                margin: 0;
            }


     
        #footer {
            border-top: 1px solid #ddd;
            margin: 0 25px;
            padding: 12px 0;
            display: flex;
            justify-content: space-between;
            font-size: 8px;
            color: #bbb;
        }

            #footer a {
                color: #bbb;
                margin-left: 10px;
            }
    </style>

</head>


<body>

    <div id="container">


       

