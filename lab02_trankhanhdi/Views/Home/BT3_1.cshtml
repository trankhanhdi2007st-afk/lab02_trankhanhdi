@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>

    <style>
        body {
            margin: 0;
            padding: 15px;
            font-family: Arial, Helvetica, sans-serif;
            background-color: white;
        }

        h2 {
            margin: 0 0 28px 0;
            font-size: 22px;
            font-weight: bold;
            text-decoration: underline;
        }

        .recipe {
            width: 488px;
            margin-left: 68px;
            background-color: #d90000;
            border: 3px solid #b30000;
            color: white;
            font-size: 11px;
        }

            .recipe table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }

            .recipe th {
                height: 32px;
                padding: 0 12px;
                text-align: left;
                font-size: 13px;
                font-weight: normal;
                background-color: #d90000;
                border-bottom: 1px dotted #eeeeee;
            }

                .recipe th:nth-child(1) {
                    width: 50%;
                }

                .recipe th:nth-child(2) {
                    width: 25%;
                }

                .recipe th:nth-child(3) {
                    width: 25%;
                }

            .recipe td {
                height: 22px;
                padding: 0 12px;
                vertical-align: middle;
            }

           
            .recipe tr:nth-child(even) td {
                background-color: #df4d4d;
            }

            .recipe tr:nth-child(odd) td {
                background-color: #c90000;
            }

            .recipe .ingredients {
                background-color: #d90000 !important;
            }

            .recipe .instructions {
                padding: 7px 10px 8px 10px;
                background-color: #d90000 !important;
                line-height: 13px;
            }

            .recipe .instructions-title {
                margin-bottom: 5px;
            }

            .recipe ol {
                margin: 0;
                padding-left: 22px;
            }

            .recipe li {
                padding-left: 2px;
                margin-bottom: 2px;
            }
    </style>
</head>

