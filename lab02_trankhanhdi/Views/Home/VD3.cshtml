@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Định dạng danh sách</title>
</head>
<body>
    <div>
        <p>Đây là dạng inside</p>
        <ul style="list-style-type: square; list-style-position: inside;">
            <li>item 1</li>
            <li>item 2</li>
            <li>item 3:caccaccac</li>
        </ul>

        <p>Đây là dạng outside</p>
        <ul style="list-style-type: square; list-style-position: outside;">
            <li>item 1</li>
            <li>item 2</li>
            <li>item 3:
            <li>item 3:caccaccac</li>
            </li>
        </ul>
    </div>
</body>
</html>