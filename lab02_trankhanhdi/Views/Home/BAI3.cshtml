@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Bài 3 - Three Column Layout</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background-color: white;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: #222;
        }

        #container {
            width: 640px;
            margin: auto;
        }

        #left {
            width: 115px;
            float: left;
        }

        #left-menu {
            width: 115px;
            background-color: #ffffb8;
            border: 1px solid #777;
            padding: 7px 5px;
            text-align: center;
            font-weight: bold;
        }

            #left-menu a {
                display: block;
                color: #222;
                text-decoration: underline;
                margin-bottom: 3px;
            }

            #left-menu .space {
                height: 14px;
            }

 
        #left-image {
            margin-top: 120px;
            width: 115px;
            height: 150px;
            overflow: hidden;
        }

            #left-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }


        #center {
            width: 395px;
            float: left;
            margin-left: 5px;
            border: 1px solid #777;
            min-height: 455px;
            background-color: white;
        }

        #center-content {
            padding: 8px;
        }

        #center h1 {
            margin: 0 0 12px 0;
            font-size: 22px;
        }

        #center h2 {
            margin: 14px 0 8px 0;
            font-size: 18px;
        }

        #center p {
            font-size: 11px;
            line-height: 1.35;
            margin-bottom: 10px;
        }

        #center a {
            color: #333;
        }

        #right {
            width: 115px;
            float: right;
        }

        #right-box {
            width: 115px;
            background-color: #ff9187;
            border: 1px solid #777;
            padding: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 11px;
            line-height: 1.35;
        }

        #footer {
            clear: both;
            width: 640px;
            height: 33px;
            margin-top: 0;
            background-color: #ff9187;
            border-top: 1px solid #777;
            text-align: center;
            line-height: 33px;
            font-weight: bold;
        }

            #footer a {
                color: black;
            }
    </style>

</head>

<body>

    <div id="container">

        <div id="left">

            <div id="left-menu">

                <a href="#">Templates</a>

                <a href="#">Left Column</a>

                <a href="#">Right Column</a>

                <a href="#">Top &amp; Right</a>

                <a href="#">3 Column</a>

                <a href="#">3 Column &amp; Footer</a>

                <div class="space"></div>

                <a href="#">Threaded</a>

                <a href="#">Threaded Item</a>

                <a href="#">Unthreaded</a>

                <div class="space"></div>

                <a href="#">prosandcons1</a>

                <a href="#">prosandcons2</a>

                <a href="#">spider1</a>

            </div>


         

            <div id="left-image">

                <img src="/Content/images/zeros.jpg" alt="Hình minh họa" />

            </div>

        </div>



        <div id="center">

            <div id="center-content">

                <h1>
                    Three Column Layout with Footer
                </h1>


                <p>
                    This layout demonstrates a three column layout
                    with a bottom footer stretching the width of the page.
                    The left and right columns are positioned absolutely
                    and the central column of text is given very large
                    margins to accommodate the width of the side columns.
                </p>


                <p>
                    The footer is positioned along the bottom of the page.
                    Some CSS properties attached to various elements of
                    the page ensure that it is always at the bottom of
                    the view port or the document, whichever is lower.
                    This is based on an
                    <a href="#">interesting CSS technique</a>.
                </p>


                <h2>
                    Dummy text
                </h2>


