@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>List Style Image</title>

    <style>
        body {
            margin: 28px 40px;
            font-family: "Times New Roman", serif;
        }

        table {
            width: 505px;
            border-collapse: collapse;
            font-size: 12px;
        }

        td {
            border: 1px solid #555;
            height: 55px;
            vertical-align: top;
            padding: 5px 8px;
        }

      
        .code {
            width: 260px;
            font-family: "Courier New", monospace;
            font-size: 10px;
            line-height: 13px;
            padding-left: 25px;
        }

      
        .result {
            width: 245px;
            padding-left: 15px;
            font-size: 14px;
            vertical-align: middle;
        }

        
        .red-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .red-list li {
                position: relative;
                padding-left: 24px;
                margin: 3px 0;
            }

                .red-list li::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 3px;
                    width: 14px;
                    height: 14px;
                    background-color: red;
                    border-radius: 50%;
                }
    </style>
</head>

<body>

    <table>

        <tr>

        
            <td class="code">
                &lt;ul&gt;<br>
                &nbsp;&nbsp;&lt;li&gt;First list for custom marker.&lt;/li&gt;<br>
                &nbsp;&nbsp;&lt;li&gt;Second list for custom marker.&lt;/li&gt;<br>
                &lt;/ul&gt;
            </td>

            
            <td class="result">

                <ul class="red-list">
                    <li>First list for custom marker.</li>
                    <li>Second list for custom marker.</li>
                </ul>

            </td>

        </tr>

    </table>

</body>
</html>