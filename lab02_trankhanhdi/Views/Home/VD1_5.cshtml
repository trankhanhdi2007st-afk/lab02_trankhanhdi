@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Bố cục trang web</title>

    <style>
        body {
            background-color: #CCCCCC;
            font-family: Arial, Helvetica, sans-serif;
            margin: 0;
            padding: 0;
        }

        
        #container {
            border: 2px solid #000000;
            width: 760px;
            background-color: #CCCCCC;
            margin: 20px auto;
        }

       
        #banner {
            background-color: #EFEFEF;
            height: 100px;
            padding: 0;
        }

       
        #navigator {
            background-color: #999999;
            padding: 5px 0;
            border-top: 2px solid black;
            border-bottom: 2px solid black;
        }

        
        #sidebar {
            width: 160px;
            float: left;
        }

       
        #content {
            margin-left: 160px;
            min-height: 400px;
            border-left: 2px solid black;
            background-color: #FFFFFF;
        }

        
        #footer {
            clear: both;
            background-color: #999999;
            border-top: 2px solid black;
            text-align: center;
            padding: 5px 0;
        }
    </style>
</head>

<body>

    <div id="container">

       
        <div id="banner">
            BANNER
        </div>

     
        <div id="navigator">
            NAVIGATOR
        </div>

       
        <div id="sidebar">
            SIDEBAR
        </div>

        
        <div id="content">
            CONTENT
        </div>

       
        <div id="footer">
            FOOTER
        </div>

    </div>

</body>
</html>