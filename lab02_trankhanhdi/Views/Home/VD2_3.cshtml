@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>List Style Position</title>

    <style>
        body {
            margin: 5px 15px;
            font-family: "Times New Roman", serif;
        }

        table {
            width: 505px;
            border-collapse: collapse;
            font-size: 12px;
        }

        td {
            border: 1px solid #555;
            height: 65px;
            vertical-align: top;
            padding: 3px 8px;
        }

       
        .code {
            width: 260px;
            font-family: "Courier New", monospace;
            font-size: 10px;
            line-height: 12px;
            padding-left: 25px;
        }

       
        .result {
            width: 245px;
            font-size: 14px;
            padding-left: 25px;
        }

      
        .inside {
            list-style-position: inside;
            margin: 0;
            padding-left: 0;
        }

       
        .outside {
            list-style-position: outside;
            margin: 0;
            padding-left: 25px;
        }
    </style>
</head>

<body>

    <table>

       
        <tr>
            <td class="code">
                &lt;ul style="list-style-position:inside;"&gt;<br>
                &nbsp;&nbsp;&lt;li&gt;First one&lt;br&gt;second line<br>
                &nbsp;&nbsp;&lt;li&gt;Second one<br>
                &lt;/ul&gt;
            </td>

            <td class="result">
                <ul class="inside">
                    <li>First one<br>second line</li>
                    <li>Second one</li>
                </ul>
            </td>
        </tr>

        <tr>
            <td class="code">
                &lt;ul style="list-style-position:outside;"&gt;<br>
                &nbsp;&nbsp;&lt;li&gt;First one&lt;br&gt;second line<br>
                &nbsp;&nbsp;&lt;li&gt;Second one<br>
                &lt;/ul&gt;
            </td>

            <td class="result">
                <ul class="outside">
                    <li>First one<br>second line</li>
                    <li>Second one</li>
                </ul>
            </td>
        </tr>

    </table>

</body>
</html>