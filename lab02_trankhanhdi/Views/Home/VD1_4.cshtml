@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Navigator</title>

    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif;
        }

        #menu a,
        #menu a:visited {
            position: relative;
            text-decoration: none;
            text-align: center;
            background-color: #9aaabe;
            color: #fff;
            display: block;
            width: 10em;
            border: 2px solid #fff;
            border-color: #def #678 #345 #cde;
            padding: 0.25em;
            margin: 0.5em auto;
        }

            #menu a:hover {
                top: 2px;
                left: 2px;
                color: #fff;
                border-color: #345 #cde #def #678;
            }
    </style>
</head>

<body>

    <div id="menu">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">History</a>
        <a href="#">Team</a>
        <a href="#">Offices</a>
    </div>

</body>
</html>